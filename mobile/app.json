{
  "expo": {
    "name": "闪记",
    "slug": "flash-notes",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "flash-notes",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "闪记需要访问您的相册来导入学习截图",
          "cameraPermission": "闪记需要访问相机来拍摄学习资料"
        }
      ],
      "expo-asset"
    ],
    "ios": {
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "闪记需要访问您的相册来导入学习截图"
      }
    },
    "android": {
      "permissions": [
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE"
      ]
    }
  }
}

{
  "expo": {
    "name": "闪记",
    "slug": "flash-notes",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "flash-notes",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "闪记需要访问您的相册来导入学习截图",
          "cameraPermission": "闪记需要访问相机来拍摄学习资料"
        }
      ],
      "expo-asset",
      "expo-router",
      "expo-sharing",
      "expo-status-bar"
    ],
    "ios": {
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "闪记需要访问您的相册来导入学习截图"
      }
    },
    "android": {
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.coconiniy.flashnotes"
    },
    "extra": {
      "eas": {
        "projectId": "15eb17d5-11aa-4d92-abde-4c9d41c4a3db"
      }
    }
  }
}
